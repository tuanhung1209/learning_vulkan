#version 450

layout(local_size_x = 256) in;

struct GrassTransformData {
    vec4 translation;
    vec2 scale;
};

struct PointLight {
    vec4 position;
    vec4 color;
};

layout(set = 0, binding = 0) uniform GlobalUbo {
    mat4 projection;
    mat4 view;
    mat4 inverseView;
    vec4 ambientLightColor;
    PointLight pointlights[10];
    int numLights;
    vec4 fogColor;
    float fogNear;
    float fogFar;
    float time;
} ubo;

layout(std430, set = 1, binding = 0) buffer GrassBuffer {
    GrassTransformData transforms[];
};

layout(std430, set = 1, binding = 1) readonly buffer HeightBuffer {
    float heights[];
};

layout(std430, set = 1, binding = 2) buffer VisibleGrassBuffer {
    GrassTransformData visibleGrass[];
};

layout(std430, set = 1, binding = 3) buffer IndirectCmd {
    uint indexCount, instanceCount, firstIndex;
    int vertexOffset;
    uint firstInstance;
} indirectCmd;

layout(push_constant) uniform Push {
    uint gridSize;
    uint terrainResolution;
    float heightScale;
    float spacing;
    float bladeHeight;
    float windDirX;
    float windDirZ;
    float windFreq;
    float windAmplitude;
    float turbPower;
    float turbSize;
    float droopStrength;
    float xPeriod;
    float yPeriod;
    float windBias;
    vec4 baseColor;
    vec4 tipColor;
} push;

uint wang_hash(uint seed) {
    seed = (seed ^ 61u) ^ (seed >> 16u);
    seed *= 9u;
    seed = seed ^ (seed >> 4u);
    seed *= 0x27d4eb2du;
    seed = seed ^ (seed >> 15u);
    return seed;
}

uint rand_xorshift(uint state) {
    state ^= (state << 13u);
    state ^= (state >> 17u);
    state ^= (state << 5u);
    return state;
}

float hash(uint seed) {
    return float(rand_xorshift(wang_hash(seed))) / 4294967296.0;
}

// 3D simplex noise (adapted from webgl-noise by Ashima Arts)
vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec4 mod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
vec4 permute(vec4 x) { return mod289(((x * 34.0) + 10.0) * x); }
vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }

float snoise(vec3 v) {
    const vec2 C = vec2(1.0 / 6.0, 1.0 / 3.0);
    const vec4 D = vec4(0.0, 0.5, 1.0, 2.0);

    vec3 i = floor(v + dot(v, C.yyy));
    vec3 x0 = v - i + dot(i, C.xxx);

    vec3 g = step(x0.yzx, x0.xyz);
    vec3 l = 1.0 - g;
    vec3 i1 = min(g.xyz, l.zxy);
    vec3 i2 = max(g.xyz, l.zxy);

    vec3 x1 = x0 - i1 + C.xxx;
    vec3 x2 = x0 - i2 + C.yyy;
    vec3 x3 = x0 - D.yyy;

    i = mod289(i);
    vec4 p = permute(permute(permute(
        i.z + vec4(0.0, i1.z, i2.z, 1.0))
      + i.y + vec4(0.0, i1.y, i2.y, 1.0))
      + i.x + vec4(0.0, i1.x, i2.x, 1.0));

    float n_ = 0.142857142857;
    vec3 ns = n_ * D.wyz - D.xzx;

    vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
    vec4 x_ = floor(j * ns.z);
    vec4 y_ = floor(j - 7.0 * x_);

    vec4 x = x_ * ns.x + ns.yyyy;
    vec4 y = y_ * ns.x + ns.yyyy;
    vec4 h = 1.0 - abs(x) - abs(y);

    vec4 b0 = vec4(x.xy, y.xy);
    vec4 b1 = vec4(x.zw, y.zw);

    vec4 s0 = floor(b0) * 2.0 + 1.0;
    vec4 s1 = floor(b1) * 2.0 + 1.0;
    vec4 sh = -step(h, vec4(0.0));

    vec4 a0 = b0.xzyw + s0.xzyw * sh.xxyy;
    vec4 a1 = b1.xzyw + s1.xzyw * sh.zzww;

    vec3 p0 = vec3(a0.xy, h.x);
    vec3 p1 = vec3(a0.zw, h.y);
    vec3 p2 = vec3(a1.xy, h.z);
    vec3 p3 = vec3(a1.zw, h.w);

    vec4 norm = taylorInvSqrt(vec4(dot(p0, p0), dot(p1, p1), dot(p2, p2), dot(p3, p3)));
    p0 *= norm.x; p1 *= norm.y; p2 *= norm.z; p3 *= norm.w;

    vec4 m = max(0.6 - vec4(dot(x0, x0), dot(x1, x1), dot(x2, x2), dot(x3, x3)), 0.0);
    m = m * m;
    return 42.0 * dot(m * m, vec4(dot(p0, x0), dot(p1, x1), dot(p2, x2), dot(p3, x3)));
}

float sampleHeight(float worldX, float worldZ) {
    float halfTerrain = float(push.terrainResolution - 1) * 0.5;
    float gx = worldX + halfTerrain;
    float gz = worldZ + halfTerrain;

    gx = clamp(gx, 0.0, float(push.terrainResolution - 1));
    gz = clamp(gz, 0.0, float(push.terrainResolution - 1));

    uint x0 = uint(floor(gx));
    uint z0 = uint(floor(gz));
    uint x1 = min(x0 + 1, push.terrainResolution - 1);
    uint z1 = min(z0 + 1, push.terrainResolution - 1);

    float fx = fract(gx);
    float fz = fract(gz);

    float h00 = heights[z0 * push.terrainResolution + x0];
    float h10 = heights[z0 * push.terrainResolution + x1];
    float h01 = heights[z1 * push.terrainResolution + x0];
    float h11 = heights[z1 * push.terrainResolution + x1];

    float h = mix(mix(h00, h10, fx), mix(h01, h11, fx), fz);
    return h * push.heightScale;
}

void extractFrustumPlanes(mat4 m, out vec4 planes[6]) {
    vec4 r0 = vec4(m[0][0], m[1][0], m[2][0], m[3][0]);
    vec4 r1 = vec4(m[0][1], m[1][1], m[2][1], m[3][1]);
    vec4 r2 = vec4(m[0][2], m[1][2], m[2][2], m[3][2]);
    vec4 r3 = vec4(m[0][3], m[1][3], m[2][3], m[3][3]);

    planes[0] = r3 + r0;  // left
    planes[1] = r3 - r0;  // right
    planes[2] = r3 + r1;  // bottom
    planes[3] = r3 - r1;  // top
    planes[4] = r2;       // near
    planes[5] = r3 - r2;  // far
    for (int i = 0; i < 6; i++)
        planes[i] /= length(planes[i].xyz);
}

bool sphereInFrustum(vec4 planes[6], vec3 center, float radius) {
    for (int i = 0; i < 6; i++)
        if (dot(planes[i].xyz, center) + planes[i].w < -radius)
            return false;
    return true;
}

void main() {
    uint grassBlade = push.gridSize * push.gridSize;
    uint id = gl_GlobalInvocationID.x;
    if (id >= grassBlade) return;

    // Grid position with spacing applied
    float offset = float(push.gridSize - 1) * push.spacing * 0.5;
    float row = float(id / push.gridSize) * push.spacing - offset;
    float col = float(id % push.gridSize) * push.spacing - offset;

    // Jitter position using simplex noise
    col += snoise(vec3(col, row, 0.0) * 3.0) * 0.05 * push.spacing / 0.125;
    row += snoise(vec3(col, row, 0.0) * 4.0) * 0.05 * push.spacing / 0.125;

    // Sample height at jittered position
    float height = sampleHeight(col, row);

    // Cull grass above water level
    if (height >= 0.0)
        return;

    // Per-blade random rotation
    float rotation = hash(id * 13u + 7u) * 6.28318;

    // Height & width variation
    float noise = abs(snoise(vec3(col, row, 0.0) * 0.2));
    float heightVar = mix(0.3, 0.8, noise);
    float widthVar = mix(0.7, 1.0, hash(id * 23u + 19u));
    float bladeH = heightVar * push.bladeHeight;

    // Frustum culling — bounding sphere at blade midpoint
    vec3 center = vec3(col, height + bladeH * 0.5, row);
    float radius = max(bladeH, widthVar) * 0.75;
    vec4 planes[6];
    extractFrustumPlanes(ubo.projection * ubo.view, planes);
    if (!sphereInFrustum(planes, center, radius))
        return;

    // Append survivor to compacted visible buffer
    uint slot = atomicAdd(indirectCmd.instanceCount, 1u);
    visibleGrass[slot].translation = vec4(col, height, row, rotation);
    visibleGrass[slot].scale = vec2(widthVar, bladeH);
}
